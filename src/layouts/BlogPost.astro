---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import ReferenceSidebar from '../components/ReferenceSidebar.astro';
import RelatedPosts from '../components/RelatedPosts.astro';

type Collection = 'experience' | 'basics' | 'insight';

interface Reference {
	slug: string;
	label: string;
}

interface Props {
	title: string;
	description: string;
	pubDate: Date;
	updatedDate?: Date;
	heroImage?: ImageMetadata;
	tags?: string[];
	collection: Collection;
	postId: string;
	references?: Reference[];
	relatedPosts?: string[];
}

const {
	title,
	description,
	pubDate,
	updatedDate,
	heroImage,
	tags = [],
	collection,
	postId,
	references = [],
	relatedPosts = [],
} = Astro.props;
---

<html lang="ja">
	<head>
		<BaseHead title={title} description={description} />
		<style lang="scss">
			// グローバルの main を上書きして最大幅を広げる
			main {
				width: 100%;
				max-width: 1100px;
				padding: 3rem 1rem;

				@media (max-width: 720px) {
					padding: 1.5rem 1rem;
				}
			}

			.article-layout {
				display: grid;
				grid-template-columns: 1fr 240px;
				gap: 2rem;
				align-items: start;

				@media (max-width: 767px) {
					grid-template-columns: 1fr;
				}
			}

			.article-content {
				min-width: 0;
			}

			// スマホ時はサイドバーを記事の前に表示
			.article-sidebar {
				@media (max-width: 767px) {
					order: -1;
				}
			}

			.hero-image {
				width: 100%;
				margin-bottom: 2rem;

				img {
					display: block;
					margin: 0 auto;
					border-radius: 12px;
					box-shadow: var(--box-shadow);
				}
			}

			.prose {
				max-width: 720px;
			}

			.title {
				margin-bottom: 2rem;
				padding-bottom: 1rem;
				border-bottom: 1px solid rgb(var(--color-muted-light));
				text-align: center;

				h1 {
					margin: 0.5rem 0 0;
				}
			}

			.date {
				font-size: 0.875rem;
				color: rgb(var(--color-muted));
				margin-bottom: 0.25rem;
			}

			.last-updated-on {
				font-style: italic;
				font-size: 0.8rem;
			}
		</style>
	</head>

	<body>
		<Header />
		<main>
			<div class="article-layout">
				<article class="article-content">
					{heroImage && (
						<div class="hero-image">
							<Image width={1020} height={510} src={heroImage} alt="" />
						</div>
					)}
					<div class="prose">
						<div class="title">
							<div class="date">
								<FormattedDate date={pubDate} />
								{updatedDate && (
									<span class="last-updated-on">（更新: <FormattedDate date={updatedDate} />）</span>
								)}
							</div>
							<h1>{title}</h1>
						</div>
						<slot />
					</div>
					<RelatedPosts
						currentId={postId}
						currentCollection={collection}
						tags={tags}
						relatedPosts={relatedPosts}
					/>
				</article>

				<aside class="article-sidebar">
					<ReferenceSidebar references={references} />
				</aside>
			</div>
		</main>
		<Footer />
	</body>
</html>
