---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
---

<div class="wip-banner">
	🚧 このサイトは現在制作中です
</div>
<header>
	<nav>
		<h2><a href="/">{SITE_TITLE}</a></h2>
		<div class="internal-links">
			<HeaderLink href="/">Home</HeaderLink>
			<HeaderLink href="/experience">体験</HeaderLink>
			<HeaderLink href="/basics">基礎知識</HeaderLink>
			<HeaderLink href="/insight">知見</HeaderLink>
			<HeaderLink href="/tags">タグ</HeaderLink>
			<HeaderLink href="/about">About</HeaderLink>
		</div>
	</nav>
</header>
<style lang="scss">
	.wip-banner {
		background: #fff8e1;
		color: #7a6000;
		text-align: center;
		padding: 4.5rem 1rem;
		font-size: 1.5rem;
		border-bottom: 1px solid #f0dc82;
		box-sizing: border-box;
		position: relative;
		left: 50%;
		right: 50%;
		margin-left: -50vw;
		margin-right: -50vw;
		width: 100vw;
	}

	header {
		margin: 0;
		padding: 0 1em;
		background: white;
		box-shadow: 0 2px 8px rgba(var(--black), 5%);
	}

	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		flex-wrap: wrap;
		gap: 0.25em;

		// サイトタイトル部分のh2はヘッダー固有のサイズ調整
		h2 {
			font-size: 1em;
		}

		a {
			padding: 1em 0.5em;
			color: rgb(var(--text));
			border-bottom: 4px solid transparent;

			&:hover {
				text-decoration: none;
			}

			&.active {
				border-bottom-color: var(--accent);
			}
		}

		@media (max-width: 720px) {
			font-size: 0.875em;

			a { padding: 0.75em 0.4em; }
		}
	}
</style>