---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';

// 体験は eventDate(出来事の日付)で時系列ソート(古い順)
const posts = (await getCollection('experience')).sort(
	(a, b) => a.data.eventDate.valueOf() - b.data.eventDate.valueOf(),
);
---

<!doctype html>
<html lang="ja">
	<head>
		<BaseHead title={`体験 | ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
		<style>
			main { width: 960px; max-width: calc(100% - 2em); }
			.page-header { margin-bottom: 2rem; }
			.page-header h1 { margin-bottom: 0.5rem; }
			.page-header p { color: rgb(var(--gray)); margin: 0; }
			ul { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 1rem; }
			ul li a { display: block; text-decoration: none; color: inherit; padding: 1rem 1.25rem; border: 1px solid #e7e7e7; border-radius: 8px; transition: 0.2s ease; }
			ul li a:hover { border-color: rgb(var(--accent)); box-shadow: var(--box-shadow); }
			.title { margin: 0 0 0.5rem 0; line-height: 1.3; font-size: 1.25rem; color: rgb(var(--black)); }
			.meta { display: flex; flex-wrap: wrap; gap: 0.75rem; font-size: 0.875rem; color: rgb(var(--gray)); margin: 0; align-items: center; }
			.badge { background: #f0f0f0; padding: 0.125rem 0.5rem; border-radius: 4px; font-size: 0.75rem; }
		</style>
	</head>
	<body>
		<Header />
		<main>
			<header class="page-header">
				<h1>体験</h1>
				<p>2度の燃え尽き経験を、時系列で記録しています。</p>
			</header>
			<section>
				<ul>
					{
						posts.map((post) => (
							<li>
								<a href={`/experience/${post.id}/`}>
									<h2 class="title">{post.data.title}</h2>
									<p class="meta">
										<span><FormattedDate date={post.data.eventDate} /></span>
										<span class="badge">{post.data.episode === 'episode-teen' ? '10代' : '40歳'}</span>
										<span class="badge">{post.data.phase}</span>
									</p>
								</a>
							</li>
						))
					}
				</ul>
			</section>
		</main>
		<Footer />
	</body>
</html>