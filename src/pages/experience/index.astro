---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';

// 体験は eventDate(出来事の日付)で時系列ソート(古い順)
const posts = (await getCollection('experience')).sort(
	(a, b) => a.data.eventDate.valueOf() - b.data.eventDate.valueOf(),
);
---

<!doctype html>
<html lang="ja">
	<head>
		<BaseHead title={`体験 | ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<header class="page-header">
				<h1>体験</h1>
				<p>2度の燃え尽き経験を、時系列で記録しています。</p>
			</header>
			<section>
				<ul class="post-list">
					{
						posts.map((post) => (
							<li>
								<a href={`/experience/${post.id}/`}>
									<h2 class="post-title">{post.data.title}</h2>
									<p class="post-meta">
										<span><FormattedDate date={post.data.eventDate} /></span>
										<span class="badge">{post.data.episode === 'episode-teen' ? '10代' : '40歳'}</span>
										<span class="badge">{post.data.phase}</span>
									</p>
								</a>
							</li>
						))
					}
				</ul>
			</section>
		</main>
		<Footer />
	</body>
</html>