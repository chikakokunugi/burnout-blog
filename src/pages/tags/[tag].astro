---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import { SITE_TITLE } from '../../consts';

export async function getStaticPaths() {
	const experience = await getCollection('experience');
	const basics = await getCollection('basics');
	const insight = await getCollection('insight');

	const allPosts = [...experience, ...basics, ...insight];

	const allTags = [...new Set(allPosts.flatMap((post) => post.data.tags))];

	return allTags.map((tag) => ({
		params: { tag },
		props: {
			tag,
			experiencePosts: experience.filter((p) => p.data.tags.includes(tag)),
			basicsPosts: basics.filter((p) => p.data.tags.includes(tag)),
			insightPosts: insight.filter((p) => p.data.tags.includes(tag)),
		},
	}));
}

const { tag, experiencePosts, basicsPosts, insightPosts } = Astro.props;

const phaseLabel: Record<string, string> = {
	hope: '希望',
	strain: '不具合',
	onset: '発症',
	coping: '低空飛行',
	recovery: '回復',
};
---

<!doctype html>
<html lang="ja">
	<head>
		<BaseHead title={`#${tag} | ${SITE_TITLE}`} description={`「${tag}」タグの記事一覧`} />
		<style lang="scss">
			.tag-header {
				margin-bottom: 2.5rem;

				h1 {
					margin-bottom: 0.25rem;
					font-size: 1.75rem;
				}

				.back {
					font-size: 0.85rem;
					color: rgb(var(--gray));
					text-decoration: none;

					&:hover { text-decoration: underline; }
				}
			}

			.section {
				margin-bottom: 2.5rem;

				h2 {
					font-size: 0.9rem;
					text-transform: uppercase;
					letter-spacing: 0.05em;
					color: rgb(var(--gray));
					margin-bottom: 0.75rem;
					padding-bottom: 0.5rem;
					border-bottom: 1px solid #e7e7e7;
				}
			}

			ul {
				list-style: none;
				padding: 0;
				margin: 0;
				display: flex;
				flex-direction: column;
				gap: 0.5rem;
			}

			li a {
				display: flex;
				justify-content: space-between;
				align-items: baseline;
				gap: 1rem;
				color: rgb(var(--color-heading));
				padding: 0.5rem 0.75rem;
				border-radius: 6px;
				transition: 0.15s ease;

				&:hover {
					background: #f5f5f5;
					color: rgb(var(--accent));
					text-decoration: none;
				}
			}

			.meta {
				display: flex;
				gap: 0.5rem;
				align-items: center;
				flex-shrink: 0;
				font-size: 0.8rem;
				color: rgb(var(--color-muted));
			}

			.empty {
				color: rgb(var(--color-muted));
				font-size: 0.9rem;
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<div class="tag-header">
				<a href="/tags/" class="back">← タグ一覧に戻る</a>
				<h1>#{tag}</h1>
			</div>

			<div class="section">
				<h2>体験</h2>
				{experiencePosts.length === 0 ? (
					<p class="empty">このタグの体験記事はまだありません。</p>
				) : (
					<ul>
						{experiencePosts
							.sort((a, b) => a.data.eventDate.valueOf() - b.data.eventDate.valueOf())
							.map((post) => (
								<li>
									<a href={`/experience/${post.id}/`}>
										<span>{post.data.title}</span>
										<span class="meta">
											<span class="badge">{post.data.episode === 'episode-teen' ? '10代' : '40歳'}</span>
											<span class="badge">{phaseLabel[post.data.phase]}</span>
											<FormattedDate date={post.data.eventDate} />
										</span>
									</a>
								</li>
							))}
					</ul>
				)}
			</div>

			<div class="section">
				<h2>基礎知識</h2>
				{basicsPosts.length === 0 ? (
					<p class="empty">このタグの基礎知識記事はまだありません。</p>
				) : (
					<ul>
						{basicsPosts
							.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
							.map((post) => (
								<li>
									<a href={`/basics/${post.id}/`}>
										<span>{post.data.title}</span>
										<span class="meta">
											<FormattedDate date={post.data.pubDate} />
										</span>
									</a>
								</li>
							))}
					</ul>
				)}
			</div>

			<div class="section">
				<h2>知見</h2>
				{insightPosts.length === 0 ? (
					<p class="empty">このタグの知見記事はまだありません。</p>
				) : (
					<ul>
						{insightPosts
							.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
							.map((post) => (
								<li>
									<a href={`/insight/${post.id}/`}>
										<span>{post.data.title}</span>
										<span class="meta">
											<FormattedDate date={post.data.pubDate} />
										</span>
									</a>
								</li>
							))}
					</ul>
				)}
			</div>
		</main>
		<Footer />
	</body>
</html>
