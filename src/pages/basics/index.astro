---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';

// 基礎知識は pubDate 新しい順
const posts = (await getCollection('basics')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const kindLabel: Record<string, string> = {
	definition: '定義',
	book: '書籍',
	study: '研究',
	overview: '概論',
};
---

<!doctype html>
<html lang="ja">
	<head>
		<BaseHead title={`基礎知識 | ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<header class="page-header">
				<h1>基礎知識</h1>
				<p>バーンアウトの定義、書籍、よく知られた研究の紹介。</p>
			</header>
			<section>
				<ul class="post-list">
					{
						posts.map((post) => (
							<li>
								<a href={`/basics/${post.id}/`}>
									<h2 class="post-title">{post.data.title}</h2>
									<p class="post-meta">
										<span><FormattedDate date={post.data.pubDate} /></span>
										{post.data.kind && <span class="badge">{kindLabel[post.data.kind]}</span>}
										{post.data.sourceAuthor && <span>{post.data.sourceAuthor}</span>}
									</p>
								</a>
							</li>
						))
					}
				</ul>
			</section>
		</main>
		<Footer />
	</body>
</html>