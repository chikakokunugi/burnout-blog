---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';

// 知見は pubDate 新しい順
const posts = (await getCollection('insight')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<!doctype html>
<html lang="ja">
	<head>
		<BaseHead title={`知見 | ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
		<style>
			main { width: 960px; max-width: calc(100% - 2em); }
			.page-header { margin-bottom: 2rem; }
			.page-header h1 { margin-bottom: 0.5rem; }
			.page-header p { color: rgb(var(--gray)); margin: 0; }
			ul { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 1rem; }
			ul li a { display: block; text-decoration: none; color: inherit; padding: 1rem 1.25rem; border: 1px solid #e7e7e7; border-radius: 8px; transition: 0.2s ease; }
			ul li a:hover { border-color: rgb(var(--accent)); box-shadow: var(--box-shadow); }
			.title { margin: 0 0 0.5rem 0; line-height: 1.3; font-size: 1.25rem; color: rgb(var(--black)); }
			.meta { display: flex; flex-wrap: wrap; gap: 0.75rem; font-size: 0.875rem; color: rgb(var(--gray)); margin: 0; align-items: center; }
		</style>
	</head>
	<body>
		<Header />
		<main>
			<header class="page-header">
				<h1>知見</h1>
				<p>2度の経験と研究を踏まえて、自分なりに考えたこと。</p>
			</header>
			<section>
				<ul>
					{
						posts.map((post) => (
							<li>
								<a href={`/insight/${post.id}/`}>
									<h2 class="title">{post.data.title}</h2>
									<p class="meta">
										<span><FormattedDate date={post.data.pubDate} /></span>
									</p>
								</a>
							</li>
						))
					}
				</ul>
			</section>
		</main>
		<Footer />
	</body>
</html>